# Frontend environment configuration (.env)
# Copy this file to .env and fill in values as appropriate for your environment.
# Note: This project uses Create React App (CRA). Only REACT_APP_* variables are exposed to the browser.
# If you migrate to Vite, you would instead use VITE_* variables such as VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY.

# Core application URLs
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=

# Environment and build flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature flags
# Example CSV: featureA=true,featureB=false
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false

# Supabase (REQUIRED for this app to function)
# Obtain from your Supabase project settings (Project URL and anon public key)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=
