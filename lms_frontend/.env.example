# Example environment variables for LMS Frontend
# Copy this file to ".env" and fill in the required values.
# Note: In Create React App, only vars prefixed with REACT_APP_ are automatically exposed.
# This project expects VITE_ style variables per requirements; ensure your runtime injects them.

# Supabase configuration (REQUIRED)
# The base URL of your Supabase project (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=
# The public (anon) API key from your Supabase project settings
VITE_SUPABASE_ANON_KEY=

# Other environment variables (optional; provided by platform)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=
REACT_APP_NEXT_TELEMETRY_DISABLED=
REACT_APP_ENABLE_SOURCE_MAPS=
REACT_APP_PORT=
REACT_APP_TRUST_PROXY=
REACT_APP_LOG_LEVEL=
REACT_APP_HEALTHCHECK_PATH=
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=
