# Create React App exposes only REACT_APP_* variables to the browser.
# Copy this file to ".env" and set the values for your environment.

# Supabase (required for auth/data features)
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
REACT_APP_SUPABASE_KEY=YOUR-ANON-PUBLIC-KEY

# Frontend URL (optional; used for email redirects in auth flows)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional: API base for non-Supabase backend endpoints
# REACT_APP_API_BASE=http://localhost:4000

# Healthcheck path (optional, defaults to /healthz)
# REACT_APP_HEALTHCHECK_PATH=/healthz

# Optional feature flags
# REACT_APP_FEATURE_FLAGS=flag1,flag2
# or JSON: {"newDashboard":true}

# Logging
# REACT_APP_LOG_LEVEL=info
