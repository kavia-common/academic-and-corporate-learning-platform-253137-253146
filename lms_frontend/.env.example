# React app environment variables
# Note: React (Create React App) only exposes variables prefixed with REACT_APP_
# If you already have SUPABASE_URL and SUPABASE_KEY in your environment, the app
# will fall back to them automatically, but using the REACT_APP_ prefixed variables
# is recommended.

# Supabase configuration (required for auth/data)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# Optional public site URL used for Supabase email redirect after signup/confirm
REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional API base if using a non-Supabase backend
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=

# Optional WebSocket URL
REACT_APP_WS_URL=

# Healthcheck path (default: /healthz)
REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature flags (CSV or JSON string)
REACT_APP_FEATURE_FLAGS=

# Misc
REACT_APP_NODE_ENV=development
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_LOG_LEVEL=info
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
